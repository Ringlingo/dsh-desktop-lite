{
  "name": "dsh-runtime-inspector",
  "version": "0.1.0",
  "private": true,
  "description": "dsh bundle: a Runtimes settings section reporting the portable built-in node / python / git runtimes",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
